# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Runtime data: the SQLite database and its WAL/SHM sidecars must never be committed
*.db
*.db-wal
*.db-shm
*.db.backup
*.sqlite
*.sqlite3
/data/

# Local secrets
.env
.env.*
!.env.example

# JetBrains: only the shared ignore file is tracked
/.idea/*
!/.idea/.gitignore
